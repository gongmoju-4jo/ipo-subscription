# docker-compose용 환경변수 예시. 복사해서 .env로 사용한다: cp .env.example .env
# .env는 .gitignore 대상이며 공유가 필요한 값은 팀에서 승인한 비밀 관리 도구로 공유한다. 이 파일에는 실제 값을 넣지 않는다.

# PostgreSQL 관리자(슈퍼유저 postgres) 비밀번호. 직접 정한 값을 넣는다 (기본값 없음, DB 툴 접속에 사용, 비우면 postgres가 시작되지 않는다)
DB_PASSWORD=

# DB 이름(기본값 ipo), 관리자 계정 이름(기본값 postgres)은 바꿀 때만 주석을 풀고 값을 넣는다
# 서비스(application.yml)도 이 파일을 읽으므로 값을 비운 키는 서비스 기본값을 덮어쓴다. 쓰지 않는 키는 비워 두지 말고 주석 처리한다
# DB_NAME=
# DB_USERNAME=

# 서비스별 DB 계정 비밀번호 (account_app, subscription_app, allocation_app). 직접 정한 값을 넣는다 (기본값 없음, 비우면 postgres 초기화가 실패한다)
# docker-compose와 서비스(IntelliJ 실행 포함)가 이 파일을 같이 읽으므로 한 곳에만 적는다. 값은 따옴표, 공백, $, # 없이 영문, 숫자로 적는다
ACCOUNT_DB_PASSWORD=
SUBSCRIPTION_DB_PASSWORD=
ALLOCATION_DB_PASSWORD=

# Kafka, Kafka-UI 호스트 포트 (비워 두면 기본값 29092, 8989 사용)
# 포트가 이미 사용 중이거나 Windows 예약 포트라 실행되지 않을 때만 다른 값으로 바꾼다
# KAFKA_PORT를 바꾸면 서비스 실행 시 KAFKA_BOOTSTRAP_SERVERS도 localhost:{바꾼 포트}로 맞춘다
KAFKA_PORT=
KAFKA_UI_PORT=

# Redis 호스트 포트 (기본값 6379). IntelliJ로 띄운 게이트웨이도 이 값으로 접속한다. 포트가 이미 사용 중이거나 예약 포트라 실행되지 않을 때만 주석을 풀고 다른 값을 넣는다
# REDIS_PORT=

# 접속 대기열 입장 속도(기본 433, 초당 인원, 전체 공모주 합), 입장 허가 유효 시간(기본 PT5M)
# 대기열 효과 측정(입장 속도만 바꿔 비교)에서만 주석을 풀고 값을 넣는다. 서비스 처리량 부하 테스트(run-k6.sh)는 허가를 직접 넣으므로 바꾸지 않는다
# 평소에는 주석 그대로 둔다 (빈 값으로 두면 게이트웨이가 기동하지 않는다)
# QUEUE_ADMIT_RATE=
# QUEUE_ADMISSION_TTL=

# Eureka 대시보드 호스트 포트 (기본값 8761). 포트가 이미 사용 중이거나 예약 포트라 실행되지 않을 때만 주석을 풀고 다른 값을 넣는다
# EUREKA_PORT=

# Grafana 관리자(admin) 비밀번호. 직접 정한 값을 넣는다 (기본값 없음, 비우면 grafana가 시작되지 않는다). 따옴표, 공백, $, # 없이 영문, 숫자로 적는다
GRAFANA_ADMIN_PASSWORD=

# Prometheus(기본 9090), Grafana(기본 3000) 호스트 포트. 포트가 이미 사용 중이거나 Windows 예약 포트라 실행되지 않을 때만 주석을 풀고 다른 값을 넣는다
# PROMETHEUS_PORT=
# GRAFANA_PORT=

# Slack 장애 알림 (Grafana). 쓸 때만 주석을 풀고 값을 넣는다
# SLACK_WEBHOOK_URL: Slack Incoming Webhook URL (비밀값). 비워 두면 알림이 나가지 않는다. 장애대응 채널 URL은 배포 환경에만 넣고, 로컬은 개인 테스트 채널 URL을 쓴다
# ALERT_ENV: 메시지 제목 앞에 붙는 환경 이름 (기본값 local, 배포 환경은 prod)
# GF_SERVER_ROOT_URL: Slack 메시지 안 Grafana 링크의 주소 (기본값 http://localhost:{GRAFANA_PORT})
# SLACK_WEBHOOK_URL=
# ALERT_ENV=
# GF_SERVER_ROOT_URL=

# Kafka 토픽 파티션 수 (비워 두면 기본값 6, docker/kafka/create-topics.sh). 바꾸면 계좌, 청약, 배정 서비스의 spring.kafka.listener.concurrency도 같은 수로 맞춘다
KAFKA_TOPIC_PARTITIONS=

# 첫 관리자 계정 (account-service). 쓸 때만 주석을 풀고 둘 다 넣는다
# 계좌 서비스가 뜰 때 이 로그인 ID의 계정이 없으면 관리자(ADMIN)로 만든다. 이미 있으면 아무것도 바꾸지 않는다 (ADMIN_PASSWORD를 바꿔도 비밀번호는 그대로)
# ADMIN_LOGIN_ID: 4~20자 영문 소문자, 숫자 / ADMIN_PASSWORD: 8~20자. 하나만 넣거나 형식이 틀리면 account-service가 기동하지 않는다
# 값은 따옴표, 공백, $, #, \ 없이 적는다 ($가 들어가면 account-service가 기동하지 않고 오류 로그에 값이 찍힌다)
# ADMIN_LOGIN_ID=
# ADMIN_PASSWORD=

# JWT 서명 키 (api-gateway, account-service 공용). 표준 Base64 문자열, 디코딩 후 32바이트 이상
# 생성 예: openssl rand -base64 32
JWT_SECRET=
