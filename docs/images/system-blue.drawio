;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="290" height="240" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;② 증거금 인출 (SAGA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;margin.reserve-requested&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;청약 → 계좌&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;margin.reserved&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;계좌 → 청약&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;margin.reserve-failed&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;계좌 → 청약&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#C0392B'&gt;확정 실패, 응답 시간 초과 시 보상&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;margin.void-requested&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;청약 → 계좌&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;margin.voided&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;계좌 → 청약&lt;/span&gt;" style="fontFamily=Pretendard;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F8FF;strokeColor=#B9CCF5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontSize=13;fontColor=#1C2430;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="300" height="240" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;③ 마감, 배정&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;ipo.closed&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;청약 → 배정 (마감 스케줄러가 발행)&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo,monospace;font-size:12px'&gt;allocation.result&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B86'&gt;배정 → 계좌, 청약&lt;/span&gt;" style="fontFamily=Pretendard;rounded=1;arcSize=4;wh