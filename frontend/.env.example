# 프론트 개발 서버(npm run dev)와 미리보기 서버(npm run preview)가 /api, /ops, /prom 요청을 넘길 주소
# 복사해서 .env.local로 쓰고, 배포 서버에 붙일 때 이 값만 바꾼다
GATEWAY_URL=http://localhost:8080
OPS_URL=http://127.0.0.1:8099
PROMETHEUS_URL=http://localhost:9090

# 시연 기능(API 기록 창, 처리 상세, DLT 내용, 시스템 현황, 성과 화면). 빌드할 때 정해진다
# 지정하지 않으면 켜짐. 시연 기능 없이 빌드하려면 VITE_DEMO=false
# VITE_DEMO=false

# 관리자 화면(공모주 등록, 추첨 재현). ADMIN 계정에만 표시. 빌드할 때 정해진다
# 지정하지 않으면 켜짐. 관리자 화면 없이 빌드하려면 VITE_ADMIN_UI=false
# VITE_ADMIN_UI=false
