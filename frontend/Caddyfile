# 배포 환경의 웹 서버 (web 컨테이너). 외부에는 이 서버만 열린다 (80, 443)
# - SITE_DOMAIN의 인증서를 Let's Encrypt에서 자동으로 받고 갱신한다. http는 https로 넘긴다
#   localhost로 띄우면 Caddy 자체 인증서를 쓴다 (로컬 확인용, 브라우저 경고는 정상)
# - /api, 통합 Swagger는 게이트웨이로 넘기고, 나머지는 프론트 빌드 결과(dist)를 준다
# - /ops(운영 조회 서버), /prom(Prometheus)은 배포 환경에서 열지 않는다. 배포 이미지는 시연 기능을 빼고 빌드해서 이 경로를 부르는 화면이 없다
# HTTP/3(UDP 443)은 쓰지 않는다. 서버에서 UDP 443을 열지 않아, 켜 두면 브라우저가 HTTP/3을 광고받고 시도했다가 TCP로 돌아간다
{
	servers {
		protocols h1 h2
	}
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# 다른 사이트가 이 화면을 iframe으로 감싸지 못하게 하고, 브라우저가 파일 형식을 추측해 실행하지 않게 한다
	# defer: 게이트웨이가 이미 붙인 응답에도 값이 두 번 들어가지 않고 하나로 덮어쓴다
	header {
		defer
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
	}

	@gateway path /api/* /swagger-ui* /v3/api-docs* /account-service/v3/api-docs /subscription-service/v3/api-docs /allocation-service/v3/api-docs
	handle @gateway {
		reverse_proxy {$GATEWAY_UPSTREAM:api-gateway:8080}
	}

	# SPA 주소로 떨어지면 index.html이 200으로 나가 화면이 HTML을 JSON으로 읽으려 하므로 404로 막는다
	@internal path /ops /ops/* /prom /prom/*
	handle @internal {
		respond 404
	}

	# 파일 이름에 해시가 붙은 빌드 결과. 있으면 오래 캐시하고, 없으면 404 (index.html로 대신하면 HTML이 JS 이름으로 1년 캐시된다)
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 나머지(index.html 등)는 매번 새로 확인하게 한다
	# /accounts처럼 프론트 라우터가 처리하는 주소를 새로고침해도 index.html을 준다
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
